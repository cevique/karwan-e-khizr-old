# Copy to .env or .env.local and adjust per environment.

# Base URL of the Karwan-e-Khizr backend API (backend/ service).
#   - Android emulator:  http://10.0.2.2:8000  (10.0.2.2 = host machine's localhost)
#   - iOS simulator:     http://localhost:8000
#   - Physical device:   http://<your-machine-LAN-IP>:8000  (same Wi-Fi network;
#     find it with ipconfig / ifconfig, e.g. http://192.168.1.20:8000)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: MapLibre basemap style. Defaults to OpenFreeMap "liberty".
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Set to "true" to run against built-in demo fixtures (frontend/mocks/) instead
# of the backend. The map shows a "Demo data — not live" label in this mode.
EXPO_PUBLIC_DEMO_MODE=false
