# Environment Settings
ENV=development
DEBUG=true

# Database Settings
# Note: Using asyncpg driver for asynchronous SQLAlchemy 2.x support
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/karwan_e_khizr

# Local PostgreSQL + PostGIS container settings (used by backend/docker-compose.yml).
# These are read directly by the Postgres/PostGIS image to initialize the
# container (create the superuser, password, and default database), and are
# kept in sync with the credentials embedded in DATABASE_URL above. There is
# no code yet that derives one from the other, so if you change these,
# update DATABASE_URL to match (and vice versa).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=karwan_e_khizr
POSTGRES_PORT=5432

# Security Settings
# Make sure to change SECRET_KEY to a secure random hex string in any deployed environment
SECRET_KEY=dev_secret_key_placeholder_do_not_use_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30